%% Dumps the notation events of a score so a Python script can rebuild it as MusicXML.
#(define nl-out (open-output-file (getenv "NL_OUT")))
#(define nl-staves (make-hash-table))
#(define nl-voices (make-hash-table))
#(define nl-staff-count 0)
#(define nl-voice-count 0)
#(define (nl-rat r) (format #f "~a/~a" (numerator r) (denominator r)))
#(define (nl-mom ctx)
  (let ((m (ly:context-current-moment ctx)))
    (format #f "~a ~a" (nl-rat (ly:moment-main m)) (nl-rat (ly:moment-grace m)))))
#(define (nl-emit . items) (display (string-join (map (lambda (x) (format #f "~a" x)) items) "\t") nl-out) (newline nl-out))
#(define (nl-staff-of ctx)
  (let ((staff (ly:context-find ctx 'Staff)))
    (if staff (hashq-ref nl-staves staff 0) 0)))
#(define (nl-voice-of ctx)
  (or (hashq-ref nl-voices ctx #f)
      (begin (set! nl-voice-count (+ 1 nl-voice-count))
             (hashq-set! nl-voices ctx nl-voice-count)
             nl-voice-count)))

#(define (nl-staff-engraver context)
  (set! nl-staff-count (+ 1 nl-staff-count))
  (hashq-set! nl-staves context nl-staff-count)
  (let ((id nl-staff-count) (last-clef #f))
    (make-engraver
     (listeners
      ((key-change-event engraver event)
       (let* ((alist (ly:event-property event 'pitch-alist '()))
              (tonic (ly:event-property event 'tonic #f))
              (fifths (apply + (map (lambda (p) (cond ((> (cdr p) 0) 1) ((< (cdr p) 0) -1) (else 0))) alist))))
         (nl-emit "K" id (nl-mom context) fifths
                  (if (ly:pitch? tonic) (ly:pitch-notename tonic) -1)
                  (if (ly:pitch? tonic) (nl-rat (ly:pitch-alteration tonic)) "0/1"))))
      ((absolute-dynamic-event engraver event)
       (nl-emit "D" id (nl-mom context) (ly:event-property event 'text ""))))
     ((process-music engraver)
      (let ((clef (list (ly:context-property context 'clefGlyph "")
                        (ly:context-property context 'clefPosition 0)
                        (ly:context-property context 'clefTransposition 0))))
        (if (not (equal? clef last-clef))
            (begin (set! last-clef clef)
                   (nl-emit "C" id (nl-mom context) (car clef) (cadr clef) (caddr clef)))))))))

#(define (nl-voice-engraver context)
  (make-engraver
   (listeners
    ((note-event engraver event)
     (let ((p (ly:event-property event 'pitch #f))
           (d (ly:event-property event 'duration #f)))
       (if (and (ly:pitch? p) (ly:duration? d))
           (nl-emit "N" (nl-staff-of context) (nl-voice-of context) (nl-mom context)
                    (ly:pitch-octave p) (ly:pitch-notename p) (nl-rat (ly:pitch-alteration p))
                    (nl-rat (ly:moment-main (ly:duration-length d)))
                    (ly:duration-log d) (ly:duration-dot-count d)))))
    ((rest-event engraver event)
     (let ((d (ly:event-property event 'duration #f)))
       (if (ly:duration? d)
           (nl-emit "REST" (nl-staff-of context) (nl-voice-of context) (nl-mom context)
                    (nl-rat (ly:moment-main (ly:duration-length d)))))))
    ((multi-measure-rest-event engraver event)
     (let ((d (ly:event-property event 'duration #f)))
       (if (ly:duration? d)
           (nl-emit "REST" (nl-staff-of context) (nl-voice-of context) (nl-mom context)
                    (nl-rat (ly:moment-main (ly:duration-length d)))))))
    ((tie-event engraver event)
     (nl-emit "TIE" (nl-staff-of context) (nl-voice-of context) (nl-mom context)))
    ((slur-event engraver event)
     (nl-emit "SLUR" (nl-staff-of context) (nl-voice-of context) (nl-mom context) (ly:event-property event 'span-direction 0)))
    ((articulation-event engraver event)
     (nl-emit "ART" (nl-staff-of context) (nl-voice-of context) (nl-mom context) (ly:event-property event 'articulation-type "")))
    ((fingering-event engraver event)
     (nl-emit "FING" (nl-staff-of context) (nl-voice-of context) (nl-mom context) (ly:event-property event 'digit 0))))))

#(define (nl-score-engraver context)
  (nl-emit "SCORE")
  (let ((last-time #f) (last-bar #f))
    (make-engraver
     (listeners
      ((volta-repeat-start-event engraver event) (nl-emit "R" (nl-mom context) "start-repeat"))
      ((volta-repeat-end-event engraver event) (nl-emit "R" (nl-mom context) "end-repeat"))
      ((volta-span-event engraver event)
       (nl-emit "VS" (nl-mom context) (ly:event-property event 'span-direction 0)
                (string-join (map number->string (ly:event-property event 'volta-numbers '())) ",")))
      ((tempo-change-event engraver event)
       (let ((unit (ly:event-property event 'tempo-unit #f))
             (count (ly:event-property event 'metronome-count #f)))
         (if (and (ly:duration? unit) (number? count))
             (nl-emit "M" (nl-mom context) (nl-rat (ly:moment-main (ly:duration-length unit))) count)))))
     ((process-music engraver)
      (let ((ts (ly:context-property context 'timeSignatureFraction #f))
            (pos (ly:context-property context 'measurePosition #f))
            (bar (ly:context-property context 'currentBarNumber 0)))
        (if (and ts (not (equal? ts last-time)))
            (begin (set! last-time ts) (nl-emit "T" (nl-mom context) (car ts) (cdr ts))))
        (if (ly:moment? pos)
            (nl-emit "B" (nl-mom context) bar (nl-rat (ly:moment-main pos))))))
     ((stop-translation-timestep engraver)
      (let ((rc (ly:context-property context 'repeatCommands '()))
            (wb (ly:context-property context 'whichBar "")))
        (if (and (string? wb) (not (string=? wb "")) (not (string=? wb "|")))
            (nl-emit "BAR" (nl-mom context) wb))
        (for-each (lambda (c)
                    (cond ((symbol? c) (nl-emit "R" (nl-mom context) c))
                          ((and (pair? c) (eq? (car c) 'volta))
                           (nl-emit "V" (nl-mom context)
                                    (let ((t (cadr c))) (cond ((string? t) t) ((not t) "#f") ((markup? t) (markup->string t)) (else "?")))))))
                  rc))))))

\layout {
  \context { \Score \consists #nl-score-engraver }
  \context { \Staff \consists #nl-staff-engraver }
  \context { \Voice \consists #nl-voice-engraver }
}
